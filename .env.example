# Database
DATABASE_URL=sqlite+aiosqlite:///./data/career_agent.db
REDIS_URL=redis://localhost:6379/0

# AI Providers (NVIDIA is primary)
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Primary AI Provider: nvidia | openai | deepseek | anthropic | mistral
PRIMARY_AI_PROVIDER=nvidia

# JWT Secret (change in production!)
JWT_SECRET_KEY=jobfinder-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Scraping
SCRAPE_INTERVAL_MINUTES=1
SCRAPE_QUERY=Python Developer
SCRAPE_LOCATION=Hyderabad
SCRAPE_PORTALS=naukri,indeed,linkedin,shine,foundit,timesjobs

# Browser Automation
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO=500

# Browser Proxy (for Cloudflare/IP-blocked sites like Glassdoor)
BROWSER_PROXY=

# Scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
REQUEST_TIMEOUT=30
RATE_LIMIT_DELAY=2

# Email / Outreach (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# LinkedIn API (unofficial - uses your LinkedIn account credentials)
# IMPORTANT: Create a throwaway LinkedIn account for safety - your main account may get banned
# Get the library: pip install open-linkedin-api
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Job Search Defaults
DEFAULT_CITY=Hyderabad
DEFAULT_SKILLS=Python,SQL,Data Analysis