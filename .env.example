# AI Providers (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# JWT Secret (change in production!)
JWT_SECRET_KEY=change-this-to-a-random-secret

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Browser Proxy (for Cloudflare/IP-blocked sites like Glassdoor)
# Format: http://user:pass@proxy:port or socks5://user:pass@proxy:port
# BROWSER_PROXY=http://your-residential-proxy:port
